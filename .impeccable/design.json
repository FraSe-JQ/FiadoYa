  "narrative": {
    "northStar": "Consola operativa sobria",
    "overview": "La dirección fijada por el usuario se materializa en superficies claras, tipografía Inter y jerarquía financiera. La densidad permite consultar importes, condiciones y movimientos sin perder el contexto del comercio activo.\n\nEste registro describe el código implementado; la fuente visual normativa es `frontend/src/styles.css`, junto con los componentes Angular. No registra referencias visuales externas aprobadas.",
    "keyCharacteristics": [
      "Superficies blancas sobre fondo frío y separadores finos.",
      "Azul para acciones y énfasis; verde para identidad y estados positivos.",
      "Importes alineados y ayudas junto a los campos."
    ],
    "rules": [
      {
        "name": "The Estado con texto Rule",
        "body": "Las etiquetas conservan nombres visibles de estado además del color.",
        "section": "colors"
      },
      {
        "name": "The Cifra alineada Rule",
        "body": "Las columnas numéricas se alinean a la derecha y emplean cifras tabulares; las métricas también usan cifras tabulares.",
        "section": "typography"
      },
      {
        "name": "The Panel plano Rule",
        "body": "Los paneles de trabajo usan superficie blanca y borde fino; las capas superpuestas concentran las sombras observadas.",
        "section": "elevation"
      }
    ],
    "dos": [
      "**Do** conservar el contexto del comercio activo y las etiquetas persistentes de campos.",
      "**Do** usar cifras tabulares y alineación derecha en columnas monetarias.",
      "**Do** mantener foco visible y ayuda contextual accesible por teclado.",
      "**Do** conservar la adaptación a una columna y el desplazamiento interno de tablas en móvil."
    ],
    "donts": [
      "**Don't** sustituir el estado escrito por un indicador basado solo en color.",
      "**Don't** convertir los paneles planos de operación en tarjetas con sombras decorativas.",
      "**Don't** introducir animaciones innecesarias en esta interfaz sobria."
    ]
  }
